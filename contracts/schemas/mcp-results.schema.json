{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCP tool result, common envelope",
  "$defs": {
    "SourceLink": {
      "type": "object",
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "loki",
            "prometheus",
            "tempo",
            "github",
            "kubernetes",
            "deployment",
            "healthcheck",
            "manual",
            "docs_rag",
            "incident_memory"
          ]
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      },
      "required": [
        "source_type"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "status",
    "summary",
    "source_refs",
    "items",
    "truncated"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "empty",
        "partial",
        "error"
      ]
    },
    "summary": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceLink"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
